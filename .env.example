# ScrollSense Environment Config
SCROLLSENSE_ENV=development
SCROLLSENSE_OFFLINE_MODE=true

# AI Layer Provider Configuration
# Default is 'cache' mode for 100% offline deterministic execution.
LLM_PROVIDER=cache
LLM_MODE=cache

# NVIDIA Nemotron LLM Configuration (Default live provider)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=25

# Google Gemini Configuration (Alternative live provider via OpenAI-compatible endpoint)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_api_key_here
