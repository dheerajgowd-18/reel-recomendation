# ScrollSense Environment Config
SCROLLSENSE_ENV=development
SCROLLSENSE_OFFLINE_MODE=true

# NVIDIA Nemotron LLM Configuration (Optional AI layer)
# Default is 'cache' mode for 100% offline deterministic execution.
LLM_PROVIDER=cache
LLM_MODE=cache
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=25
